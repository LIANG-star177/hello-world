# Local demo only. Set both secrets before production.
AUTH_SECRET=replace-with-at-least-32-random-characters
TEACHER_PASSWORD=change-this-password
DATABASE_PATH=./data/attendance.sqlite
# Enable desktop simulated locations only for local development.
ENABLE_SIMULATION=false
LOCATION_RETENTION_DAYS=30

# Public HTTPS origin; on Render RENDER_EXTERNAL_URL is used automatically.
# PUBLIC_BASE_URL=https://your-attendance-site.example
